{
  "name": "maxlabs",
  "version": "0.1.0",
  "description": "OAuth-first MaxLabs coding agent for your terminal",
  "type": "module",
  "bin": {
    "maxlabs": "bin/maxlabs.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/build.mjs",
    "prepack": "npm run build",
    "start": "npm run build --silent && node bin/maxlabs.js",
    "preview": "npm run build --silent && node bin/maxlabs.js --demo",
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "maxlabs",
    "cli",
    "coding-agent",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudcenmax/maxlabs-cli.git"
  },
  "homepage": "https://github.com/cloudcenmax/maxlabs-cli#readme",
  "bugs": {
    "url": "https://github.com/cloudcenmax/maxlabs-cli/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
